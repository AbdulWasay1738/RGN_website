{
  "name": "reelgoodnews-web",
  "version": "1.0.0",
  "private": true,
  "description": "Reel Good News website and content studio",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --path=sanity/extract.json --enforce-required-fields --force && sanity typegen generate",
    "seed": "sanity exec sanity/seed/import.ts --with-user-token",
    "seed:ndjson": "tsx sanity/seed/export-ndjson.ts",
    "migrate:round-2": "sanity exec sanity/migrations/round-2.ts --with-user-token",
    "test": "vitest run",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/a11y",
    "prototype": "python -m http.server 8765 --directory reference/prototype",
    "test:e2e": "playwright test tests/e2e",
    "dev:offline": "cross-env SANITY_OFFLINE=1 next dev"
  },
  "dependencies": {
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/vision": "^6.22.0",
    "groq-js": "^2.0.1",
    "next": "^16.4.5",
    "next-sanity": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
