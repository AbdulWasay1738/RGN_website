# Sanity (the content studio at /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-04
# Viewer token: draft mode and the Presentation (live preview) tool
SANITY_API_READ_TOKEN=
# Editor token: only for `npm run seed`. Never expose it to the browser.
SANITY_API_WRITE_TOKEN=
# Shared secret for the publish webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

NEXT_PUBLIC_SITE_URL=https://reelgoodnews.com

# Local development only: render the site from content-seed/ without a Sanity
# connection. Ignored in production.
# SANITY_OFFLINE=1

# Phase 6 (integrations, not built yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GHL_API_KEY=
GHL_LOCATION_ID=
NEXT_PUBLIC_GTM_ID=
